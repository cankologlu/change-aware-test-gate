{
  "name": "change-aware-test-gate",
  "version": "0.1.0",
  "private": true,
  "description": "A Claude Code Stop hook that only lets the agent finish when the tests for the code it touched pass.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test:gate && npm run test --workspaces --if-present",
    "test:gate": "vitest run --dir scripts/gate",
    "typecheck": "tsc && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/picomatch": "^4.0.3",
    "picomatch": "^4.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
