{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run test*)",
      "Bash(npm run gate)",
      "Bash(npm run typecheck*)",
      "Bash(npx vitest *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && npx tsx scripts/gate/run.ts",
            "timeout": 300,
            "statusMessage": "Running the change-aware test gate…"
          }
        ]
      }
    ]
  }
}
